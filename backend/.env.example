# ============================================
# Backend — Spring Boot
# ============================================
SPRING_PROFILES_ACTIVE=docker

# AI Server
AI_SERVER_URL=http://ai-predicter:8000

# Database (must match root .env values)
DATABASE_URL=jdbc:postgresql://postgres:5432/detectiondb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# Admin (default user created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT (generate a strong base64-encoded secret for production)
JWT_SECRET=changeme-generate-base64-secret-at-least-32-bytes
JWT_EXPIRATION=86400000
